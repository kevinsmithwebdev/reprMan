{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@reprman/shared/repr-model": ["libs/shared/repr-model/src/index.ts"],
      "@reprman/shared/repr-validation": [
        "libs/shared/repr-validation/src/index.ts"
      ],
      "@reprman/shared/repr-rules": ["libs/shared/repr-rules/src/index.ts"],
      "@reprman/shared/quota": ["libs/shared/quota/src/index.ts"],

      "@reprman/components": ["libs/components/src/index.ts"],
      "@reprman/components/*": ["libs/components/src/*"],

      "@reprman/modals": ["libs/modals/src/index.ts"],
      "@reprman/modals/*": ["libs/modals/src/*"],

      "@reprman/state": ["libs/state/src/index.ts"],
      "@reprman/state/*": ["libs/state/src/*"],

      "@reprman/cognito-auth": ["libs/cognito-auth/src/index.ts"],
      "@reprman/cognito-auth/*": ["libs/cognito-auth/src/*"],

      "@reprman/localization": ["libs/localization/src/index.ts"],
      "@reprman/localization/*": ["libs/localization/src/*"],

      "@reprman/reprs-api": ["libs/reprs-api/src/index.ts"],
      "@reprman/reprs-api/*": ["libs/reprs-api/src/*"],

      "@reprman/utilities": ["libs/utilities/src/index.ts"],
      "@reprman/utilities/*": ["libs/utilities/src/*"],

      "@reprman/constants": ["libs/constants/src/index.ts"],
      "@reprman/constants/*": ["libs/constants/src/*"],

      "@reprman/types": ["libs/types/src/index.ts"],
      "@reprman/types/*": ["libs/types/src/*"],

      "@reprman/theme": ["libs/theme/src/index.ts"],
      "@reprman/theme/*": ["libs/theme/src/*"],

      "@client-web/test-utils": ["apps/client-web/src/test-utils/index.ts"],
      "@client-web/test-utils/*": ["apps/client-web/src/test-utils/*"]
    }
  },
  "files": ["vitest-jest-dom.d.ts"],
  "exclude": ["node_modules", "**/node_modules"]
}
