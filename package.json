{
  "name": "repr-man-web",
  "version": "2.0.7",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1042.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1042.0",
    "@aws-sdk/client-dynamodb": "^3.1042.0",
    "@aws-sdk/lib-dynamodb": "^3.1042.0",
    "@reduxjs/toolkit": "^1.8.2",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^16.11.36",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.0.5",
    "aws-amplify": "^6",
    "aws-cdk-lib": "^2.252.0",
    "bootstrap": "^5.1.3",
    "constructs": "^10.6.0",
    "eslint-import-resolver-typescript": "^3.2.5",
    "framer-motion": "^11.11.17",
    "history": "^5.3.0",
    "i18next": "^21.8.14",
    "moment": "^2.29.3",
    "react": "^18.1.0",
    "react-bootstrap": "^2.4.0",
    "react-bootstrap-icons": "^1.8.4",
    "react-dom": "^18.1.0",
    "react-redux": "^8.0.2",
    "react-router-dom": "^6.3.0",
    "redux-mock-store": "^1.5.4",
    "redux-saga": "^1.1.3",
    "sass": "^1.52.1",
    "stripe": "^17.7.0",
    "ts-jest": "^28.0.7",
    "typescript": "^4.7.2",
    "uuid": "^8.3.2"
  },
  "scripts": {
    "build:server": "nx run server:build",
    "build": "nx run client-web:build",
    "clean:lock": "rm -rf node_modules && rm -f yarn.lock && yarn install",
    "clean:coverage": "node scripts/clean-coverage.mjs",
    "clean": "rm -rf node_modules && yarn install",
    "bump:major": "node scripts/commit-with-bump.mjs major",
    "bump:minor": "node scripts/commit-with-bump.mjs minor",
    "deploy:prod": "node scripts/promote-production.mjs",
    "deploy:server:prod": "nx run server:cdk:deploy:prod",
    "deploy:server": "nx run server:cdk:deploy",
    "inspect:pr": "yarn prettier:check && yarn lint && yarn test --silent",
    "inspect": "yarn prettier:check && yarn lint && yarn test --silent",
    "inspect:affected": "yarn prettier:check && nx affected -t lint,build --base=main && yarn test --silent",
    "lint:affected": "nx affected -t lint --base=main",
    "build:affected": "nx affected -t build --base=main",
    "lint:server": "nx run server:lint",
    "lint": "nx run client-web:lint",
    "migrate:user-config": "node scripts/backfill-user-config.mjs",
    "migrate:repr-learning": "node scripts/backfill-repr-learning.mjs",
    "users:list": "node scripts/list-users.mjs",
    "users:set-status": "node scripts/set-user-status.mjs",
    "grant:subscription": "node scripts/grant-subscription.mjs",
    "postinstall": "simple-git-hooks && node scripts/patch-vitest-coverage.mjs",
    "prettier": "prettier --write apps/client-web/src",
    "prettier:check": "prettier --check apps/client-web/src",
    "sonar:scan": "sonar-scanner -Dsonar.organization=\"$SONAR_ORGANIZATION\"",
    "start": "nx serve client-web",
    "test:one": "sh ./scripts/testOne.sh",
    "test:server": "nx run server:test",
    "test:coverage": "node scripts/run-all-coverage.mjs",
    "test:watch": "nx run client-web:test:watch",
    "test:e2e": "nx run client-web:test:e2e",
    "test:e2e:ui": "playwright test --config apps/client-web/e2e/playwright.config.cts --ui",
    "test:e2e:install": "playwright install chromium",
    "test": "nx run client-web:test",
    "validate": "yarn lint && prettier --check apps/client-web/src && yarn test --silent && yarn test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@babel/preset-env": "^7.18.9",
    "@babel/preset-react": "^7.18.6",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.26.0",
    "@typescript-eslint/parser": "^5.26.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "babel-jest": "^28.1.3",
    "esbuild": "^0.28.0",
    "eslint": "^7.32.0 || ^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "gh-pages": "^4.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^28.1.3",
    "jsdom": "^25.0.0",
    "nx": "^20.0.0",
    "prettier": "2.7.1",
    "react-test-renderer": "^18.2.0",
    "simple-git-hooks": "^2.13.1",
    "tsc-alias": "^1.8.17",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "resolutions": {
    "autoprefixer": "10.4.5"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit-version-bump.mjs"
  }
}
