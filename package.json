{
  "name": "repr-man-web",
  "version": "0.14.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1042.0",
    "@aws-sdk/lib-dynamodb": "^3.1042.0",
    "@reduxjs/toolkit": "^1.8.2",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^16.11.36",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.0.5",
    "aws-amplify": "^6",
    "aws-cdk-lib": "^2.252.0",
    "bootstrap": "^5.1.3",
    "constructs": "^10.6.0",
    "eslint-import-resolver-typescript": "^3.2.5",
    "framer-motion": "^11.11.17",
    "history": "^5.3.0",
    "i18next": "^21.8.14",
    "moment": "^2.29.3",
    "react": "^18.1.0",
    "react-bootstrap": "^2.4.0",
    "react-bootstrap-icons": "^1.8.4",
    "react-dom": "^18.1.0",
    "react-redux": "^8.0.2",
    "react-router-dom": "^6.3.0",
    "redux-mock-store": "^1.5.4",
    "redux-saga": "^1.1.3",
    "sass": "^1.52.1",
    "ts-jest": "^28.0.7",
    "typescript": "^4.7.2",
    "uuid": "^8.3.2"
  },
  "scripts": {
    "start": "nx serve client-web",
    "build": "nx run client-web:build",
    "build:server": "nx run server:build",
    "deploy:server": "nx run server:cdk:deploy",
    "deploy:server:prod": "nx run server:cdk:deploy:prod",
    "deploy:prod": "node scripts/promote-production.mjs",
    "clean": "rm -rf node_modules && yarn install",
    "clean:lock": "rm -rf node_modules && rm -f yarn.lock && yarn install",
    "test": "nx run client-web:test",
    "test:one": "sh ./scripts/testOne.sh",
    "test:watch": "nx run client-web:test:watch",
    "prettier": "prettier --write apps/client-web/src",
    "lint": "nx run client-web:lint",
    "lint:server": "nx run server:lint",
    "inspect": "yarn prettier --loglevel=warn && yarn lint && yarn test --silent",
    "inspect:pr": "yarn prettier --loglevel=warn && yarn lint && yarn test --silent",
    "validate": "yarn prettier && yarn lint && prettier --check apps/client-web/src && yarn test --silent",
    "test:server": "nx run server:test",
    "migrate:user-config": "node scripts/backfill-user-config.mjs",
    "postinstall": "simple-git-hooks",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "bump:minor:commit": "npm version minor --no-git-tag-version && git add package.json"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.18.9",
    "@babel/preset-react": "^7.18.6",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.26.0",
    "@typescript-eslint/parser": "^5.26.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "babel-jest": "^28.1.3",
    "esbuild": "^0.28.0",
    "eslint": "^7.32.0 || ^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "gh-pages": "^4.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^28.1.3",
    "jsdom": "^25.0.0",
    "nx": "^20.0.0",
    "prettier": "2.7.1",
    "react-test-renderer": "^18.2.0",
    "simple-git-hooks": "^2.13.1",
    "tsc-alias": "^1.8.17",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "resolutions": {
    "autoprefixer": "10.4.5"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn bump:minor:commit"
  }
}
