{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "aws-lambda", "jest"]
  },
  "include": ["src/**/*.ts", "../../libs/shared/**/src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "../../libs/shared/**/*.test.ts"]
}
