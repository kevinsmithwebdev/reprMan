{
  "name": "client-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/client-web/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/build"],
      "options": {
        "command": "node ../../scripts/with-build-metadata.mjs VITE \"npx vite build\"",
        "cwd": "apps/client-web"
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite",
        "cwd": "apps/client-web"
      },
      "configurations": {
        "development": {}
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "command": "node scripts/run-vitest-coverage.mjs",
        "cwd": "apps/client-web",
        "forwardAllArgs": true
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../node_modules/vitest/vitest.mjs",
        "cwd": "apps/client-web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0 --cache --cache-location .eslintcache",
        "cwd": "apps/client-web"
      }
    }
  },
  "tags": []
}
