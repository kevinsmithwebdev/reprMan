# Copy to the repository root as `.env.e2e` (gitignored via `.env` pattern)
# or export these variables before running Playwright.

# App under test (Playwright can start `yarn start` when this URL is reachable)
E2E_BASE_URL=http://localhost:3000

# Dedicated Cognito user in the Dev pool (not your personal account)
E2E_USER_EMAIL=you+e2e@example.com
E2E_USER_PASSWORD=your-dev-password

# Signup tests (optional — creates real Cognito users)
# E2E_RUN_SIGNUP=1
# E2E_SIGNUP_DOMAIN=mail.example.com
# E2E_SIGNUP_CONFIRM_CODE=123456

# Set to skip auto-starting the Vite dev server (e.g. server already running)
# E2E_SKIP_WEB_SERVER=1
