{
  "name": "client-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/client-mobile",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo start",
        "cwd": "apps/client-mobile"
      }
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/start-android.mjs",
        "cwd": "apps/client-mobile"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint \"app/**/*.{js,jsx,ts,tsx}\" \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
        "cwd": "apps/client-mobile"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p tsconfig.json",
        "cwd": "apps/client-mobile"
      }
    }
  },
  "tags": ["platform:mobile"]
}
