# Repo root — Vite reads this file when running `yarn start` / `nx serve client-web`.
# For local UI against the Dev API, copy outputs from CloudFormation stack ReprServerStack-Dev
# (UserPoolId, UserPoolClientId, ApiBaseUrl). See README.md.

VITE_COGNITO_USER_POOL_ID=string
VITE_COGNITO_USER_POOL_CLIENT_ID=string
VITE_REPRS_API_BASE_URL=https://xxxx.execute-api.region.amazonaws.com
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_REQUIRE_HOME_SIGN_IN=boolean
VITE_ALLOW_ANONYMOUS_HOME=boolean

# Mobile app (Expo) — same values as VITE_* above, with EXPO_PUBLIC_ prefix.
# Read from repo root `.env` when running `yarn start:mobile`.
EXPO_PUBLIC_COGNITO_USER_POOL_ID=string
EXPO_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=string
EXPO_PUBLIC_REPRS_API_BASE_URL=https://xxxx.execute-api.region.amazonaws.com
EXPO_PUBLIC_COGNITO_IDENTITY_POOL_ID=
EXPO_PUBLIC_REQUIRE_HOME_SIGN_IN=boolean
EXPO_PUBLIC_ALLOW_ANONYMOUS_HOME=boolean

# Stripe (set on Lambda at deploy time — not used by the Vite client directly)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://reprman.com/subscribe?success=1
# STRIPE_CHECKOUT_CANCEL_URL=https://reprman.com/subscribe?canceled=1
# STRIPE_PORTAL_RETURN_URL=https://reprman.com/settings
