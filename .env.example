# Repo root — Vite reads this file when running `yarn start` / `nx serve client-web`.
# For local UI against the Dev API, copy outputs from CloudFormation stack ReprServerStack-Dev
# (UserPoolId, UserPoolClientId, ApiBaseUrl). See README.md.

VITE_COGNITO_USER_POOL_ID=string
VITE_COGNITO_USER_POOL_CLIENT_ID=string
VITE_REPRS_API_BASE_URL=https://xxxx.execute-api.region.amazonaws.com
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_REQUIRE_HOME_SIGN_IN=boolean
VITE_ALLOW_ANONYMOUS_HOME=boolean
